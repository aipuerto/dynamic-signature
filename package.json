{
  "name": "dynamic-signature",
  "version": "1.0.0",
  "description": "Dynamic e-mail signatures and digital business cards on a single Cloudflare Worker.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "preview": "node scripts/smoke.mjs --serve",
    "test": "node scripts/smoke.mjs",
    "dev": "wrangler dev",
